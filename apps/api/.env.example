# API server
PORT=4000

# Database (cloud Postgres link goes here; local default matches docker-compose.yml)
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/real_estate_crm

# CORS allowlist (comma-separated origins), consumed with credentials: true
CORS_ORIGINS=http://localhost:3000

# JWT secrets — generate with: head -c 32 /dev/urandom | base64
# Never commit real values; keep them out of version control.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=20

# Background jobs (node-cron expressions). Overdue-sync keeps Task.isOverdue
# honest; token-prune deletes expired refresh tokens. Off in tests.
CRON_ENABLED=true
OVERDUE_SYNC_CRON=* * * * *
TOKEN_PRUNE_CRON=17 3 * * *

# AI features (Phase 6): any OpenAI-compatible provider. Unset key = the AI
# endpoints answer 503 ("set AI_API_KEY") and the rest of the CRM runs normally.
# Examples:
#   OpenAI:     https://api.openai.com/v1              model gpt-6-luna
#   Groq:       https://api.groq.com/openai/v1         model openai/gpt-oss-20b
#   OpenRouter: https://openrouter.ai/api/v1           model openrouter/free
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/  model gemini-3.8-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_TIMEOUT_MS=30000

# Property image uploads — Cloudinary (https://console.cloudinary.com →
# Dashboard → Product Environment Credentials: Cloud name, API key, API
# secret). All three unset = POST /api/v1/properties/:id/images answers 503
# naming these vars; creating/browsing properties keeps working (same pattern
# as the AI key). The API proxies the upload, so the secret never reaches the
# browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: password assigned to the 3 seed users (dev only; default Password123!)
# SEED_PASSWORD=
