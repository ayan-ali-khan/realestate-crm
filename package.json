{
  "name": "realestate-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Real Estate CRM with AI-powered lead management",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "bun run --filter \"@crm/api\" dev",
    "dev:web": "bun run --filter \"@crm/web\" dev",
    "build": "bun run --filter \"*\" build",
    "typecheck": "bun run --filter \"*\" typecheck",
    "lint": "bun run --filter \"*\" lint",
    "test": "bun run --filter \"@crm/api\" test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
