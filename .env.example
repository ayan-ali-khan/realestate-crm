# --- Local Postgres (docker compose) ---
# Dev-only defaults; change anything that leaves your machine.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=real_estate_crm
POSTGRES_PORT=5432

# Convenience copy used by apps/api/.env
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/real_estate_crm
